# ==============================================================================
# TimesFM Serve Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Model & Checkpoint Selection
# ------------------------------------------------------------------------------
# Google hosts several TimesFM model checkpoints on Hugging Face:
# Hugging Face Hub: https://huggingface.co/google
# Official GitHub:  https://github.com/google-research/timesfm
#
# Supported Checkpoints:
# -----------------------------------------------------------------------------
# 1. TimesFM 3.0 (Latest, Multivariate, Cross-Variate Attention, 9 Quantiles)
#    License: timesfm-non-commercial-license-v1.0 (Research & Evaluation)
#    TIMESFM_MODEL_ID=google/timesfm-3.0-pytorch
#
# 2. TimesFM 2.5 (200M Checkpoint, Fast & Lightweight)
#    License: Apache-2.0 (Permissive / Commercial use allowed)
#    TIMESFM_MODEL_ID=google/timesfm-2.5-200m-pytorch
#
# 3. TimesFM 2.0 (500M Checkpoint, Foundation Model with Covariates)
#    License: Apache-2.0 (Permissive / Commercial use allowed)
#    TIMESFM_MODEL_ID=google/timesfm-2.0-500m-pytorch
#
# 4. TimesFM 1.0 (Legacy 200M Checkpoint)
#    License: Apache-2.0 (Permissive / Commercial use allowed)
#    TIMESFM_MODEL_ID=google/timesfm-1.0-200m
#
# 5. Local Checkpoint (Absolute or relative directory with weights & config)
#    TIMESFM_MODEL_ID=/path/to/local/model_directory
# -----------------------------------------------------------------------------

# Active checkpoint (default: TimesFM 3.0)
TIMESFM_MODEL_ID=google/timesfm-3.0-pytorch

# Optional Hugging Face Token (recommended to avoid API rate limits or if using gated repos)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional Hugging Face Cache Directory (default: /home/appuser/.cache/huggingface in container)
# HF_HOME=/home/appuser/.cache/huggingface

# ------------------------------------------------------------------------------
# Hardware Acceleration
# ------------------------------------------------------------------------------

# Execution device: 'auto' (detects CUDA GPU, falls back to CPU), 'cuda', or 'cpu'
DEVICE=auto

# Maximum batch size to pass through the model at once (adjust based on RAM/VRAM)
BATCH_SIZE=32

# ------------------------------------------------------------------------------
# Inference & Horizon Parameters
# ------------------------------------------------------------------------------

# Default forecast horizon length if not specified in the API request
DEFAULT_HORIZON=32

# Absolute maximum forecast horizon length allowed by the server
MAX_HORIZON=512

# Apply internal z-score / instance scaling on series before inference
NORMALIZE_INPUTS=true

# ------------------------------------------------------------------------------
# Web Server & Telemetry Settings
# ------------------------------------------------------------------------------

# Network interface to bind the server (0.0.0.0 listens on all interfaces)
HOST=0.0.0.0

# Port to bind the server
PORT=8088

# Logging verbosity: debug, info, warning, error
LOG_LEVEL=info
