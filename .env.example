# ==============================================================================
# TimesFM Serve Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Model & Hardware Configuration
# ------------------------------------------------------------------------------

# Hugging Face model repository ID to load
TIMESFM_MODEL_ID=google/timesfm-3.0-pytorch

# Execution device: 'auto' (detects CUDA), 'cuda', or 'cpu'
DEVICE=auto

# Optional Hugging Face Token (if you are hitting rate limits or using gated models)
# HF_TOKEN=hf_your_token_here

# ------------------------------------------------------------------------------
# Inference Tuning
# ------------------------------------------------------------------------------

# Maximum batch size to pass through the model at once (adjust based on RAM/VRAM)
BATCH_SIZE=32

# Default forecast horizon length if not specified in the API request
DEFAULT_HORIZON=32

# Absolute maximum forecast horizon length allowed by the server
MAX_HORIZON=512

# Apply internal z-score / instance scaling on series before inference
NORMALIZE_INPUTS=true

# ------------------------------------------------------------------------------
# Web Server Settings
# ------------------------------------------------------------------------------

# Network interface to bind the server
HOST=0.0.0.0

# Internal container port
PORT=8088

# Logging verbosity (debug, info, warning, error)
LOG_LEVEL=info
